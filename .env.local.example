# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية
# لا ترفع .env.local لـ GitHub أبداً (محمي تلقائياً عبر .gitignore)

# ---------------------------------------------------------------------------
# Base URL للموقع — يُستخدم في JSON-LD (Schema.org) و OG tags
# غيّره إلى النطاق الحقيقي عند النشر (مثلاً https://tedxalfalahyouth.com)
# ---------------------------------------------------------------------------
BASE_URL=https://www.tedxalfalahyouth.com

# ---------------------------------------------------------------------------
# رابط شراء التذاكر عبر منصة Platinumlist
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PLATINUMLIST_URL=https://platinumlist.net/event/tedx-youth-alfalah

# ---------------------------------------------------------------------------
# رابط خريطة Google المُضمَّنة في صفحة المكان (Venue)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VENUE_MAP_URL=https://www.google.com/maps?q=Dubai&output=embed

# ---------------------------------------------------------------------------
# الأصول المسموح بها لـ CORS في API routes (مفصولة بفاصلة)
# ---------------------------------------------------------------------------
ALLOWED_API_ORIGINS=https://www.tedxalfalahyouth.com,https://tedxalfalahyouth.com,http://localhost:3000

# ---------------------------------------------------------------------------
# SMTP Hostinger — إرسال الإيميلات التلقائية (تأكيد Apply, فورم Contact,
# فورم Partnerships) عبر صناديق الدومين مباشرة. بديل Resend.
# الحساب: marhaba@ — كلمة المرور من hPanel (Website → Email Accounts → Manage)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=marhaba@tedxalfalahyouth.com
SMTP_PASS=<EMPTY - fill from hPanel, never commit real value>
EMAIL_FROM=TEDxAlFalah Youth <marhaba@tedxalfalahyouth.com>

# ---------------------------------------------------------------------------
# الصناديق المستلمَة — أين تذهب كل رسالة
# ADMIN_APPLICATIONS_EMAIL: إشعار كل طلب Apply (مع كامل البيانات)
# CONTACT_EMAIL: رسائل فورم Contact العامة (General/Speaking/Volunteering)
# PARTNER_EMAIL: رعايات + استفسارات Partnerships (تحقق من الاسم النهائي
#                للصندوق في hPanel: partners@ أو partner@)
# MEDIA_EMAIL: استفسارات الإعلام (Media)
# ---------------------------------------------------------------------------
ADMIN_APPLICATIONS_EMAIL=apply@tedxalfalahyouth.com
CONTACT_EMAIL=marhaba@tedxalfalahyouth.com
PARTNER_EMAIL=partners@tedxalfalahyouth.com
MEDIA_EMAIL=media@tedxalfalahyouth.com

# ---------------------------------------------------------------------------
# Google Sheets — لتخزين طلبات Apply
# راجع خطوة 11.10 بخطة التنفيذ لشرح إنشاء Service Account كامل
# ---------------------------------------------------------------------------
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — حماية كل الفورمات الأربعة من البوتات والسبام
# سجّل مجاناً على https://dash.cloudflare.com/?to=/:account/turnstile
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Upstash Redis — لتحديد عدد الطلبات المسموحة (Rate Limiting) على كل فورم
# سجّل مجاناً على https://console.upstash.com
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Sanity CMS — لإدارة المتحدثين والفريق والفعاليات والرعاة
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=hisn3dku
NEXT_PUBLIC_SANITY_DATASET=production
# مطلوب عند نشر Sanity Studio بشكل منفصل (environment variables للمشروع)
SANITY_STUDIO_PROJECT_ID=
SANITY_WEBHOOK_SECRET=
# ---------------------------------------------------------------------------
# Analytics — Google Analytics 4 (مفعل حالياً)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-N3JFXW8D7J
# Plausible (اختياري — بديل خصوصية، يفضّل تعطيل GA4 إن قررت استخدامه)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

