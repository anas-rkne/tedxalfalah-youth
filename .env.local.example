# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية
# لا ترفع .env.local لـ GitHub أبداً (محمي تلقائياً عبر .gitignore)

# ---------------------------------------------------------------------------
# Base URL للموقع — يُستخدم في JSON-LD (Schema.org) و OG tags
# غيّره إلى النطاق الحقيقي عند النشر (مثلاً https://tedxalfalahyouth.com)
# ---------------------------------------------------------------------------
BASE_URL=https://www.tedxalfalahyouth.com

# ---------------------------------------------------------------------------
# رابط شراء التذاكر عبر منصة Platinumlist
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PLATINUMLIST_URL=https://platinumlist.net/event/tedx-youth-alfalah

# ---------------------------------------------------------------------------
# رابط خريطة Google المُضمَّنة في صفحة المكان (Venue)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VENUE_MAP_URL=https://www.google.com/maps?q=Dubai&output=embed

# ---------------------------------------------------------------------------
# الأصول المسموح بها لـ CORS في API routes (مفصولة بفاصلة)
# ---------------------------------------------------------------------------
ALLOWED_API_ORIGINS=https://www.tedxalfalahyouth.com,https://tedxalfalahyouth.com,http://localhost:3000

# ---------------------------------------------------------------------------
# الموعد الفعلي لإغلاق التقديم (اختياري — يُستخدم إن حُدّد مكان الثابت في
# src/lib/constants.ts). صيغة ISO زمن غرينتش+4. لاختبار الإغلاق مؤقتًا ضع تاريخًا ماضيًا.
# ---------------------------------------------------------------------------
# APPLICATION_DEADLINE=2026-09-14T23:59:59+04:00

# ---------------------------------------------------------------------------
# نص الموعد المعروض في الواجهة (اختياري — ينسخ الموعد بالشكل النصي العربي/الإنجليزي)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APPLICATION_DEADLINE=September 14, 2026

# ---------------------------------------------------------------------------
# SMTP Hostinger — إرسال الإيميلات التلقائية (تأكيد Apply, فورم Contact,
# فورم Partnerships) عبر صناديق الدومين مباشرة. بديل Resend.
# الحساب: marhaba@ — كلمة المرور من hPanel (Website → Email Accounts → Manage)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=marhaba@tedxalfalahyouth.com
SMTP_PASS=<EMPTY - fill from hPanel, never commit real value>
EMAIL_FROM=TEDxAlFalah Youth <marhaba@tedxalfalahyouth.com>

# ---------------------------------------------------------------------------
# الصناديق المستلمَة — أين تذهب كل رسالة
# ADMIN_APPLICATIONS_EMAIL: إشعار كل طلب Apply (مع كامل البيانات)
# CONTACT_EMAIL: رسائل فورم Contact العامة (General/Speaking/Volunteering)
# PARTNER_EMAIL: رعايات + استفسارات Partnerships (تحقق من الاسم النهائي
#                للصندوق في hPanel: partners@ أو partner@)
# MEDIA_EMAIL: استفسارات الإعلام (Media)
# ---------------------------------------------------------------------------
ADMIN_APPLICATIONS_EMAIL=apply@tedxalfalahyouth.com
CONTACT_EMAIL=marhaba@tedxalfalahyouth.com
PARTNER_EMAIL=partners@tedxalfalahyouth.com
MEDIA_EMAIL=media@tedxalfalahyouth.com

# ---------------------------------------------------------------------------
# Google Sheets — لتخزين طلبات Apply
# راجع خطوة 11.10 بخطة التنفيذ لشرح إنشاء Service Account كامل
# ---------------------------------------------------------------------------
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — حماية كل الفورمات من البوتات والسبام
# سجّل مجاناً على https://dash.cloudflare.com/?to=/:account/turnstile
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Upstash Redis — لتحديد عدد الطلبات المسموحة (Rate Limiting) على كل فورم
# سجّل مجاناً على https://console.upstash.com
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# لوحة إدارة الطلبات (/admin/applications)
# كلمة مرور المشرف — مطلوبة لفتح اللوحة ولكل طلب API منها.
# بدون هذه القيمة تعيد نقاط /api/admin/* الخطأ 503 (اللوحة معطّلة).
# استخدم كلمة قوية (16+ حرفًا) ولا تشاركها إلا مع فريق المراجعة.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=

# مدّة صلاحية توكن لوحة الإدارة (تُقرأ في src/lib/jwt.ts).
# الافتراضي 12h — يكفي فعالية مسائية كاملة دون إعادة دخول أثناء العرض.
# الصيغة: رقم بالثواني، أو نصّ يقبله jose ("12h" / "90m" / "2d").
# ⚠️ لا يوجد أي مسار تجديد (refresh) للتوكن؛ عند انتهائه تفكّ اللوحة
# الجلسة تلقائياً وتعيدك لنموذج الدخول.
# ADMIN_TOKEN_TTL=12h

# ---------------------------------------------------------------------------
# وضع الاختبار المحلي للمصادقة (اختياري — للاختبارات فقط، لا للإنتاج)
# ---------------------------------------------------------------------------
# QA_AUTH_MODE=local
# ⛔ لا تفعّله على الإنتاج أبداً. يبدّل مصدر الهوية من Google Sheets إلى
#    مستخدمين في ذاكرة العملية، ويستخدم نفس دوال التجزئة والتحقق نفسها.
#    الغرض: فكّ قفل الاختبارات الآلية، لأن `isAdminConfigured()` يفحص
#    `ADMIN_PASSWORD` فقط بينما `getUsersTab()` يرمي بلا `GOOGLE_SHEET_ID`
#    — أي أن كل طلب إداري = 503 على أي جهاز بلا Sheets.
#
#    تحتاج معه: ADMIN_PASSWORD (دائماً)، و QA_LOCAL_VIEWER_PASSWORD (اختياري
#    لكن مطلوب لاختبار مصفوفة الصلاحيات admin / viewer / بلا توكن).
#    QA_LOCAL_VIEWER_PASSWORD=
#
#    حاجز أمان: في NODE_ENV=production يُرفض الوضع إلا مع تأكيد صريح
#    QA_ALLOW_LOCAL_AUTH=true. سكربتات الاختبار تضبطه تلقائياً.
#    QA_ALLOW_LOCAL_AUTH=true

# ---------------------------------------------------------------------------
# QA_TEST_MODE — تجاوز البوابات الثلاثة **للاختبارات فقط** (لا للإنتاج)
# ---------------------------------------------------------------------------
# QA_TEST_MODE=1
# QA_ALLOW_TEST_MODE=true
# ⛔ ما يفتحه هذا الوضع بالضبط هو ما يحمي الإنتاج:
#    - `validateOrigin` يتجاوز رفض الأصول الغريبة (CORS موسَّع).
#    - `verifyTurnstile` يقبل الرمز الثابت `qa-test-bypass`.
#    - `isAdminConfigured()` يقبل `QA_AUTH_MODE=local`.
#    ⇒ أي اختبار نجاح يعمل تحت هذا الوضع **يمرّ حتى لو حُذف الفحص**، فهو
#      لا يثبت أن البوابات تعمل، بل أنها معطّلة.
#    لذلك توجد طبقة اختبار **أخرى** لا وضع لها إطلاقاً:
#      node scripts/qa-test-server.mjs --secure   ← QA_TEST_MODE مُطفأ
#      npm run test:qa:security                   ← 403 و429 و503 حقيقية
#
# ---------------------------------------------------------------------------
# QA_SECURITY_LAB — محاكاة عطل مصدر الهوية (لاختبار 503 وحده)
# ---------------------------------------------------------------------------
# QA_SECURITY_LAB=1
# QA_ALLOW_SECURITY_LAB=true
# 🎯 لماذا مبدؤه منفصل عن QA_TEST_MODE: الوضع الآمن يعمل والوضع مُطفأ،
#    فأي خيط depends على `isTestMode()` معطّل حيث نحتاجه بالضبط. وهذا
#    يجعل 503 (عطل الهوية ⇒ لا 401) غير قابل للاختبار: في الوضع المحلي
#    الهوية في الذاكرة ولا تنهار أبداً.
# ⛔ حاجز مزدوج: في NODE_ENV=production يُرفض إلا مع
#    QA_ALLOW_SECURITY_LAB=true. وفيه يُقرأ رأس `x-qa-identity-failure: 1`
#    لتعطيل **طلب واحد** فقط (لا الخادم كله).
#    ⚠️ هذا يولّد 503 القائم فعلاً ولا يتجاوز أي فحص — محاكاة لعطل، لا خرق.
#
# ---------------------------------------------------------------------------
# منافذ خوادم QA المعزولة (اختيارية — الافتراضي يكفي)
# ---------------------------------------------------------------------------
# QA_TEST_PORT=3222            # وضع الاختبار المعتاد
# QA_SECURE_PORT=3223          # الوضع الآمن (npm run test:qa:security)
# QA_FAKE_UPSTASH_PORT=3999    # خادم Redis في الذاكرة

# ---------------------------------------------------------------------------
# Live Q&A Wall — بيانات جدار الأسئلة الحية (ملفات JSON على السيرفر)
# QA_DATA_DIR: مسار مطلق ثابت يبقى بين عمليات البناء/إعادة التشغيل
# (مثال: /home/tedx/htdocs/tedxalfalahyouth.com/store). إن تُرك فارغاً
# يُستخدم <cwd>/store. اختياري لكن يُنصح به في الإنتاج.
# ---------------------------------------------------------------------------
QA_DATA_DIR=


# ---------------------------------------------------------------------------
# Sanity CMS — لإدارة المتحدثين والفريق والفعاليات والرعاة
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=hisn3dku
NEXT_PUBLIC_SANITY_DATASET=production
# مطلوب عند نشر Sanity Studio بشكل منفصل (environment variables للمشروع)
SANITY_STUDIO_PROJECT_ID=
SANITY_WEBHOOK_SECRET=
# ---------------------------------------------------------------------------
# Analytics — Google Analytics 4 (مفعل حالياً)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-N3JFXW8D7J
# Plausible (اختياري — بديل خصوصية، يفضّل تعطيل GA4 إن قررت استخدامه)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

